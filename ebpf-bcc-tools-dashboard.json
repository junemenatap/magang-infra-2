{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source already scraping beyla-frontend/backend in your stack",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "heatmap",
      "name": "Heatmap",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": "1.0.0"
    }
  ],
  "title": "eBPF bcc Tools (Cloudflare ebpf_exporter)",
  "description": "Metrics from biolatency and cachestat, running via ghcr.io/cloudflare/ebpf_exporter alongside the Beyla demo stack.",
  "tags": [
    "ebpf",
    "bcc",
    "beyla-demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter Scrape Health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"ebpf-bcc-exporter\"}",
          "legendFormat": "ebpf-bcc-exporter",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Block IO Latency Heatmap (biolatency)",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Raw distribution of block IO completion latency, from block_rq_insert/issue/complete tracepoints.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_exporter_bio_latency_seconds_bucket[1m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s",
          "axisLabel": "latency"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "reverse": false
        }
      }
    },
    {
      "id": 3,
      "title": "Block IO Latency p50 / p95 / p99 (by device, operation)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ebpf_exporter_bio_latency_seconds_bucket[5m])) by (le, device, operation))",
          "legendFormat": "p50 {{device}}/{{operation}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_bio_latency_seconds_bucket[5m])) by (le, device, operation))",
          "legendFormat": "p95 {{device}}/{{operation}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ebpf_exporter_bio_latency_seconds_bucket[5m])) by (le, device, operation))",
          "legendFormat": "p99 {{device}}/{{operation}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Page Cache Operations Rate (cachestat)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "cache_access / cache_writes / page_add_lru / page_mark_dirties per second.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_exporter_page_cache_ops_total[1m])) by (operation)",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "OOM Kills (cumulative)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Total OOM killer invocations since ebpf-metrics-exporter started. 0 is the expected, healthy state -- this only increments on a real out-of-memory kill.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "sum(ebpf_exporter_oom_kills_total)",
          "legendFormat": "OOM kills",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "ext4 Latency Heatmap (ext4dist)",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "ext4 read/write/open/sync/getattr latency distribution.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_exporter_ext4_latency_seconds_bucket[1m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s",
          "axisLabel": "latency"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "reverse": false
        }
      }
    },
    {
      "id": 7,
      "title": "ext4 Latency p95 (by operation)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_ext4_latency_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "p95 {{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "TCP Retransmits: Custom Tracer vs Cloudflare exporter (cross-check)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Two independent implementations counting the same kernel event. Labels differ (process-centric vs connection-centric) so this compares aggregate rates, not per-connection matches. Cloudflare's version also splits true retransmits from tail-loss-probes; the custom tracer doesn't distinguish these.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_tcp_retransmits_total[1m]))",
          "legendFormat": "Custom TCP tracer (total)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ebpf_exporter_tcp_retransmit_ipv4_packets_total{type=\"retransmit\"}[1m]))",
          "legendFormat": "Cloudflare exporter (retransmit only, IPv4)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(ebpf_exporter_tcp_retransmit_ipv4_packets_total{type=\"tail_loss_probe\"}[1m]))",
          "legendFormat": "Cloudflare exporter (tail-loss-probe, IPv4)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "sum"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Softirq Latency p95: Raise->Entry vs Entry->Exit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Time from softirq raise to CPU pickup (entry), vs time spent actually running (service), per softirq type.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_softirq_entry_latency_seconds_bucket[5m])) by (le, kind))",
          "legendFormat": "entry {{kind}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_softirq_service_latency_seconds_bucket[5m])) by (le, kind))",
          "legendFormat": "service {{kind}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Softirq Raised vs Serviced Rate (by kind)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_exporter_softirq_raised_total[1m])) by (kind)",
          "legendFormat": "raised {{kind}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ebpf_exporter_softirq_serviced_total[1m])) by (kind)",
          "legendFormat": "serviced {{kind}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Per-CPU Softirq Load (percpu-softirq)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Softirq rate per CPU core, all types combined -- uneven lines indicate poor IRQ/RSS balancing across cores.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_exporter_softirqs_total[1m])) by (cpu)",
          "legendFormat": "cpu {{cpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 12,
      "title": "CFS Throttling Latency p95 (by cgroup)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How long CFS-bandwidth-limited cgroups (e.g. Docker containers with CPU limits) spend throttled before being allowed to run again.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_cfs_throttling_seconds_bucket[5m])) by (le, cgroup))",
          "legendFormat": "{{cgroup}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 13,
      "title": "Kernel Timer Firings (top 8 functions)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Which kernel functions are firing hrtimers most often -- useful for spotting unexpectedly chatty timer sources.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 61
      },
      "targets": [
        {
          "expr": "topk(8, sum(rate(ebpf_exporter_timer_starts_total[1m])) by (function))",
          "legendFormat": "{{function}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 14,
      "title": "Accept Queue Latency p95 (by port)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How long a connection sits in the accept queue before your app calls accept(). Needs real inbound connections to populate.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 69
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_accept_latency_seconds_bucket[5m])) by (le, port))",
          "legendFormat": "port {{port}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 15,
      "title": "TCP SYN Backlog Size p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Depth of the SYN queue (not a duration -- a count of pending half-open connections). Rising values can precede SYN-flood-style connection drops.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 69
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_tcp_syn_backlog_bucket[5m])) by (le))",
          "legendFormat": "p95 backlog size",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 16,
      "title": "UDP Receive Drops (by local port)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "UDP packets dropped because the receive buffer was full -- 0 is the healthy state.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 77
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_exporter_udp_fail_queue_rcv_skbs_total[1m])) by (local_port)",
          "legendFormat": "port {{local_port}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 17,
      "title": "Memory Shrinker Latency p95 (shrinklat)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How long the kernel's memory reclaim path (shrink_node) takes -- rises under real memory pressure, adjacent signal to oomkill.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 77
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ebpf_exporter_shrink_node_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 shrink_node latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 18,
      "title": "Syscalls (top 10 by name)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 85
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(ebpf_exporter_syscalls_total[1m])) by (syscall))",
          "legendFormat": "{{syscall}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 19,
      "title": "Syscall Errors (by errno)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Failed syscalls broken out by errno -- e.g. ENOENT, EACCES. Cross-checkable against opensnoop's own per-event ERR column.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 85
      },
      "targets": [
        {
          "expr": "sum(rate(ebpf_exporter_syscall_errors_total[1m])) by (errno)",
          "legendFormat": "{{errno}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
