#!/usr/bin/env bpftrace

// syncsnoop.bt - Trace sync()-family syscalls: sync(), fsync(),
// fdatasync(), msync(), sync_file_range() -- explicit requests to
// flush page cache contents to disk.
//
// Adapted for Debian 11's bpftrace v0.11.3:
//   - no strftime() -> elapsed time instead
//   - no -q flag exists in this build (confirmed via bpftrace --help) --
//     not needed anyway since StandardError=journal already keeps the
//     startup banner out of the log file
//   - no maps used at all: this is entry-only, nothing to correlate
//     across probes, so none of the map-related bugs from the other
//     three tools apply here

BEGIN
{
    printf("%-15s %-7s %-16s %s\n", "TIME(ms)", "PID", "COMM", "CALL");
}

tracepoint:syscalls:sys_enter_sync
{
    printf("%-15d %-7d %-16s %s\n", elapsed / 1000000, pid, comm, "sync");
}

tracepoint:syscalls:sys_enter_fsync
{
    printf("%-15d %-7d %-16s %s\n", elapsed / 1000000, pid, comm, "fsync");
}

tracepoint:syscalls:sys_enter_fdatasync
{
    printf("%-15d %-7d %-16s %s\n", elapsed / 1000000, pid, comm, "fdatasync");
}

tracepoint:syscalls:sys_enter_msync
{
    printf("%-15d %-7d %-16s %s\n", elapsed / 1000000, pid, comm, "msync");
}

tracepoint:syscalls:sys_enter_sync_file_range
{
    printf("%-15d %-7d %-16s %s\n", elapsed / 1000000, pid, comm, "sync_file_range");
}